{
    "rewrites": [
        {
            "source": "/socket.io/:path*",
            "destination": "/api"
        },
        {
            "source": "/join/:path*",
            "destination": "/api"
        },
        {
            "source": "/",
            "destination": "/api"
        },
        {
            "source": "/:path*",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "client/**"
        }
    }
}